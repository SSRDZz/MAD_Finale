# =============================================================
# STM32CubeIDE / STM32CubeMX project
# =============================================================

# ---- Build output (regenerated on every build) ----
/Debug/
/Release/
/build/
/Build/
/cmake-build-*/

# Compiler / linker artefacts (also covers stray copies outside Debug/Release)
*.o
*.obj
*.d
*.dep
*.elf
*.axf
*.map
*.list
*.lst
*.su
*.cyclo
*.srec
*.hex
*.bin
*.a
*.lib

# ---- CubeIDE / Eclipse workspace files (machine specific) ----
/.metadata/
/RemoteSystemsTempFiles/
/.externalToolBuilders/
.settings/language.settings.xml
*.launch.bak
.recommenders/
.apt_generated/

# ---- Debug probe logs / SWV / trace ----
JLinkLog.txt
*.rttlog
*.swo
*.itm
openocd.log

# ---- Backups and temp files ----
*~
*.bak
*.orig
*.tmp
*.swp
*.swo

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Other editors ----
.vscode/
.idea/

# ---- Optional: other toolchains, in case you ever open the project in them ----
# Keil MDK
/MDK-ARM/**/*.o
/MDK-ARM/**/*.d
/MDK-ARM/Objects/
/MDK-ARM/Listings/
/MDK-ARM/RTE/
*.uvguix.*
# IAR
/EWARM/settings/
/EWARM/*/
*.dep

# =============================================================
# KEEP these tracked (do NOT add them above):
#   .project  .cproject  .mxproject  *.ioc   -> project + CubeMX config
#   *.ld                                     -> linker scripts
#   *.s  (Startup/)                          -> startup assembly
#   Core/ (or Src/ Inc/), Drivers/           -> your code + HAL/CMSIS
#   .settings/ (except language.settings.xml)
# =============================================================